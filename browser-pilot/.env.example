# Copy to %USERPROFILE%\.browserpilot\.env and fill in the providers you use.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
XAI_API_KEY=
TOGETHER_API_KEY=

# Name of the assistant in `pilot chat`
# BROWSERPILOT_ASSISTANT_NAME=Pilot

# Default model for every run (provider/model)
BROWSERPILOT_MODEL=groq/openai/gpt-oss-120b

# Any other OpenAI-compatible server, used as -m custom/<model>
# BROWSERPILOT_BASE_URL=http://localhost:1234/v1
# BROWSERPILOT_API_KEY=
